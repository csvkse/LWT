<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SystemStatusProvider 的 Windows 降级 P/Invoke 使用 LibraryImport 源生成，需要 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinuxWebTool.Contracts\LinuxWebTool.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinuxWebTool.ArchitectureTests" />
    <InternalsVisibleTo Include="LinuxWebTool.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Terminal/shell/terminal-bashrc.sh" Link="terminal-bashrc.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(BaseIntermediateOutputPath)native/liblinuxwebtool_pty.so" Link="liblinuxwebtool_pty.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <Target Name="BuildLinuxPty" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          Inputs="Terminal/native/linuxwebtool_pty.c" Outputs="$(BaseIntermediateOutputPath)native/liblinuxwebtool_pty.so">
    <MakeDir Directories="$(BaseIntermediateOutputPath)native" />
    <Exec Command="cc -shared -fPIC -O2 -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Terminal/native/linuxwebtool_pty.c&quot; -o &quot;$(BaseIntermediateOutputPath)native/liblinuxwebtool_pty.so&quot; -lutil" />
  </Target>

</Project>
