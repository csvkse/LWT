{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Warning"
    },
    "LogFile": {
      "LogLevel": {
        "Default": "Information",
        "LinuxWebTool": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "SQLite": ""
  },
  "Data": {
    "Directory": "data"
  },
  "Admin": {
    "UserName": "admin",
    "Password": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "LinuxWebTool",
    "Audience": "LinuxWebTool",
    "ExpireHours": 12
  },
  "Shell": {
    "DefaultTimeoutSeconds": 60,
    "MaxTimeoutSeconds": 86400,
    "MaxOutputBytes": 65536,
    "MaxConcurrent": 4,
    "WorkingDirectory": ""
  },
  "FileLog": {
    "Directory": "logs",
    "AppFilePrefix": "app",
    "DebugFilePrefix": "debug"
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
