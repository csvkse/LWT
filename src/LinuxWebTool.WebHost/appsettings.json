{
  "Urls": "http://0.0.0.0:5270",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Warning"
    },
    "LogFile": {
      "LogLevel": {
        "Default": "Information",
        "LinuxWebTool": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "SQLite": ""
  },
  "Data": {
    "Directory": "data"
  },
  "Admin": {
    "UserName": "admin",
    "Password": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "LinuxWebTool",
    "Audience": "LinuxWebTool",
    "ExpireHours": 12
  },
  "Shell": {
    "DefaultTimeoutSeconds": 60,
    "MaxTimeoutSeconds": 86400,
    "MaxOutputBytes": 65536,
    "MaxConcurrent": 4,
    "WorkingDirectory": ""
  },
  "Media": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "MaxConcurrent": 1,
    "MaxBatchSubmit": 500,
    "LogRetentionDays": 7
  },
  "FileLog": {
    "Directory": "logs",
    "AppFilePrefix": "app",
    "DebugFilePrefix": "debug"
  },
  "Retention": {
    "FileLogDays": 30,
    "ExecutionHistoryDays": 90,
    "OperationLogDays": 180,
    "CleanupIntervalHours": 24
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
