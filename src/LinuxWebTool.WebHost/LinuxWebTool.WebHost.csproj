<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>LinuxWebTool.WebHost</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- EndpointsMapper.g.cs 使用 ASP.NET Delegate 路由 API；运行时路由已由项目生成器验证。 -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <!-- 非 AOT 模式（极速开发/测试构建）下解耦重型生成器、裁剪分析器、资源嵌入与调试符号 -->
  <PropertyGroup Condition="'$(PublishAot)' == 'false'">
    <IsAotCompatible>false</IsAotCompatible>
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
    <!-- 开发环境直读物理磁盘 wwwroot，关闭内嵌资源生成，大幅降低 Csc 与静态资源计算开销 -->
    <GenerateEmbeddedFilesManifest>false</GenerateEmbeddedFilesManifest>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅在生产 AOT 模式下将前端静态文件打包嵌入程序集；开发模式物理 wwwroot 已随目录同步直读 -->
    <EmbeddedResource Include="wwwroot\**" Exclude="wwwroot\node_modules\**" Condition="'$(PublishAot)' != 'false'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinuxWebTool.Contracts\LinuxWebTool.Contracts.csproj" />
    <ProjectReference Include="..\LinuxWebTool.Application\LinuxWebTool.Application.csproj" />
    <ProjectReference Include="..\LinuxWebTool.Infrastructure\LinuxWebTool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时数据目录（数据库/凭据/密钥/日志）绝不能进发布产物：凭据会随包泄露 -->
    <None Remove="data\**" />
    <Content Remove="data\**" />
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Quartz" />
  </ItemGroup>
</Project>
