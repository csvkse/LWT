{
  "manifestVersion": 1,
  "id": "socks5-forwarder",
  "name": "SOCKS5 客户端边缘中继网关",
  "category": "Network",
  "version": "1.0.0",
  "description": "多端口、多节点 SOCKS5 over WSS 伪装中继网关，为局域网设备提供免客户端加密出海与访问控制",
  "icon": "🌐",
  "profile": "resident",
  "runtime": "go",
  "entrypoint": "cmd/socks5-forwarder/main.go",
  "arguments": [
    "-config",
    "{stateDir}/config.json",
    "-port",
    "{port}"
  ],
  "network": {
    "mode": "port",
    "port": 18090,
    "portEnv": "FORWARDER_PORT",
    "portConflictPolicy": "avoid",
    "supportHttp": true
  },
  "supervision": {
    "autoRestart": true,
    "flappingThresholdSec": 10,
    "maxCrashRetries": 3
  },
  "ui": {
    "entry": "web",
    "title": "SOCKS5 中继网关控制台",
    "icon": "🌐"
  }
}
