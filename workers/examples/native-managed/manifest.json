{
  "manifestVersion": 1,
  "hostApiVersion": "1",
  "id": "native-managed-demo",
  "name": "原生受控常驻微服务示例",
  "category": "Native",
  "version": "1.0.0",
  "description": "原生常驻程序并启用 HTTP 管理协议接口 (handshake / health / invoke / shutdown)。",
  "author": "Antigravity",
  "mode": "Service",
  "runtime": "Native",
  "source": "package",
  "entrypoint": "bin/service",
  "network": {
    "routingMode": "path",
    "portEnv": "PORT"
  },
  "control": {
    "handshakePath": "/control/handshake",
    "healthPath": "/control/health",
    "invokePath": "/control/invoke",
    "shutdownPath": "/control/shutdown",
    "supportedCapabilities": ["handshake", "health", "invoke", "shutdown"]
  },
  "supervision": {
    "autoRestart": true
  }
}
