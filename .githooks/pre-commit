#!/usr/bin/env sh
# LinuxWebTool Git Pre-Commit Security Gate
# 拦截暂存区中的明文密钥、真实 IP、未脱敏密码与隧道 ID

if ! command -v node >/dev/null 2>&1; then
    echo "⚠️ [Security Gate] 未检测到 Node.js，跳过提交前增量安全扫描（将在 CI 阶段严格验证）。"
    exit 0
fi

node .githooks/security-gate.cjs --staged
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [Security Gate] 提交被拦截！检测到敏感凭据、真实地址或未脱敏配置。"
    echo "👉 请参考 AGENTS.md 第 7 节规范进行脱敏，或将真实凭据存入 /env/.envdev。"
    exit 1
fi

exit 0
